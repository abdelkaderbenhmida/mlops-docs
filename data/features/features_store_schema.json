{
  "store": "lightweight-parquet",
  "versioned_by": "dvc",
  "features": {
    "Tenure": {
      "type": "float64",
      "description": "Months the customer has stayed",
      "expected_range": [
        0,
        120
      ],
      "dtype": "float64"
    },
    "MonthlyCharges": {
      "type": "float64",
      "description": "Monthly subscription charge",
      "expected_range": [
        0,
        1000
      ],
