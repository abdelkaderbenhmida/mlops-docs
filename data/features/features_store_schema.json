{
  "store": "lightweight-parquet",
  "versioned_by": "dvc",
  "features": {
    "store_id": {
      "type": "int64",
      "description": "Store identifier",
      "expected_range": [
        1,
        100
      ],
      "dtype": "float64"
    },
    "sku_id": {
      "type": "int64",
      "description": "Product (SKU) identifier",
      "expected_range": [
        1,
        200
      ],
      "dtype": "float64"
    },
    "day_of_week": {
      "type": "int64",
      "description": "Day of week (0=Monday)",
      "expected_range": [
        0,
        6
      ],
      "dtype": "float64"
    },
    "month": {
      "type": "int64",
      "description": "Calendar month",
      "expected_range": [
        1,
        12
      ],
      "dtype": "float64"
    },
    "is_holiday": {
      "type": "int64",
      "description": "1 if the day is a public holiday",
      "expected_range": [
        0,
        1
      ],
      "dtype": "float64"
    },
    "price": {
      "type": "float64",
      "description": "Selling price",
      "expected_range": [
        0,
        500
      ],
      "dtype": "float64"
    },
    "promotion": {
      "type": "int64",
      "description": "1 if the product is on promotion",
      "expected_range": [
        0,
        1
      ],
      "dtype": "float64"
    },
    "temperature": {
      "type": "float64",
      "description": "Outside temperature (C)",
      "expected_range": [
        -50,
        150
      ],
      "dtype": "float64"
    },
    "inventory_level": {
      "type": "int64",
      "description": "Stock on hand",
      "expected_range": [
        0,
        10000
      ],
      "dtype": "float64"
    },
    "competitor_price": {
      "type": "float64",
      "description": "Competitor selling price",
      "expected_range": [
        0,
        500
      ],
      "dtype": "float64"
    },
    "store_traffic": {
      "type": "int64",
      "description": "Store footfall for the day",
      "expected_range": [
        0,
        50000
      ],
      "dtype": "float64"
    },
    "units_sold": {
      "type": "int64",
      "description": "Target: units sold",
      "expected_range": [
        0,
        100000
      ],
      "dtype": "float64"
    }
  }
}