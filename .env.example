# Copy to .env and adjust. No real secrets are committed to the repository.

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_NAME=demand_model
# For local runs without a server: sqlite:///mlruns/mlflow.db
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# --- MinIO / DVC remote (local defaults) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=mlops-bucket
DVC_REMOTE_URL=s3://mlops-bucket/data
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_ENDPOINT_URL=http://localhost:9000

# --- Postgres (MLflow backend store) ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000
RELOAD_INTERVAL=0
# MLFLOW_MODEL_URI=models:/demand_model/Production

# --- Local stack (docker/docker-compose.yml + mlflow/docker-compose.yml) ---
MINIO_BUCKET=mlops-bucket
AIRFLOW_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Quality gates ---
MIN_F1=0.35
MIN_ACCURACY=0.70
MIN_ROC_AUC=0.72

# --- Drift detection ---
DRIFT_THRESHOLD=0.3
DRIFT_REFERENCE=data/monitoring/reference.csv
DRIFT_CURRENT=data/monitoring/current.csv

# --- Alerting ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
# ALERT_EMAIL_TO=
