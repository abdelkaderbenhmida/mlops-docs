# syntax=docker/dockerfile:1
# MLflow server image: tracking UI + registry backed by Postgres (backend
# store) and MinIO/S3 (artifact store). Depends on the sibling compose stack.

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MLFLOW_S3_ENDPOINT_URL=${MLFLOW_S3_ENDPOINT_URL:-http://minio:9000} \
    AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID:-minio} \
    AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY:-minio123}

RUN pip install --upgrade pip \
    && pip install "mlflow>=2.9,<4" "boto3>=1.34,<2" "psycopg2-binary>=2.9,<3"

RUN useradd --create-home --uid 1000 mlflowuser

USER mlflowuser
EXPOSE 5000

CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000"]
